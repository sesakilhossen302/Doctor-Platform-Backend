# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for the admin dashboard
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# ---------- Database ----------
# connection_limit = connections per Node process. With PM2 cluster (N cores) total = N x limit.
# In production put PgBouncer in front of PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctor_platform?schema=public&connection_limit=20&pool_timeout=10

# ---------- Redis (optional in dev; required for multi-instance production) ----------
# Leave empty to use the in-memory cache (single process only).
REDIS_URL=

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
# DEV ONLY: when true, OTP is always 123456 and returned in the API response. MUST be false in production.
OTP_DEV_MODE=true

# ---------- Booking ----------
SLOT_HOLD_MINUTES=10

# ---------- Payments ----------
# demo  = server-side simulated payment (development/demo only; refused in production)
# bkash = real bKash gateway (next phase)
PAYMENT_PROVIDER=demo

# ---------- Calls (Agora) ----------
# Create a free project at https://console.agora.io → copy App ID and App Certificate.
# The certificate stays on the server; apps only receive short-lived tokens.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# DEMO ONLY: allow starting an appointment call at any time (not just around the slot).
CONSULT_JOIN_ANYTIME=true
# Instant call (call center) service fee in taka; platform fee is added from admin settings.
INSTANT_CALL_SERVICE_FEE=50

# ---------- Admin-managed integrations ----------
# Agora, Gmail and Firebase are normally set in Admin → Settings → Integrations (stored encrypted in the DB).
# Key used to encrypt those secrets. Set once and keep it; changing it means re-entering the secrets.
# If empty, a key is derived from JWT_ACCESS_SECRET.
SETTINGS_ENCRYPTION_KEY=
